# Patterns to ignore when building Helm packages.
# config/config.yaml must stay in: templates read it with .Files.Get.
.DS_Store
.git/
.gitignore
.github/
.helmignore
*.tgz
*.bak
*.tmp
*.swp
.idea/
.vscode/
README*.md
examples/
scripts/
# Anchored: /tests/ is the in-pod acceptance suite; templates/tests/ must stay.
/tests/
# Per-cluster instance values are passed with -f, never packaged.
/deploy/
