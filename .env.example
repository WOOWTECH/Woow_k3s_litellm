# LiteLLM environment configuration (copy to .env and fill in real values)
# NEVER commit the real .env — this file holds PLACEHOLDERS only.

# OpenRouter API key — all models route through OpenRouter.
# Referenced in config/config.yaml as os.environ/OPENROUTER_API_KEY.
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# LiteLLM admin/master key (Bearer token for the proxy admin + /v1 APIs).
LITELLM_MASTER_KEY=sk-REPLACE_ME

# Salt key used to encrypt provider credentials stored in the DB.
# CRITICAL: set once and NEVER change it (rotating makes stored creds undecryptable).
LITELLM_SALT_KEY=sk-REPLACE_ME

# Postgres connection string driving persistence + readiness DB check.
DATABASE_URL=postgresql://litellm:litellm@postgres:5432/litellm

# Persist models managed from the Admin UI into Postgres.
STORE_MODEL_IN_DB=True
